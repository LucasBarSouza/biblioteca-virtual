create policy "insercao publica temporaria"
on public.livros for insert to anon
with check (
  char_length(titulo) between 1 and 120
  and char_length(autor) between 1 and 80
  and link like 'https://%'
  and char_length(link) < 500
  and (capa is null or capa like 'https://%' or capa like '/biblioteca-virtual/img/%')
  and (categoria is null or char_length(categoria) <= 40)
);